#!/usr/bin/env python3
"""One owned, test-only warm nREPL per Clojure project root (kaocha-sublime.runner).

usage: sublime-loop [--root DIR] [--aliases :a:b] [--env KEY=VALUE ...]
                    [--repeat N] [--perf] [--slowest N] up|status|check NS|NS/VAR...|down

State lives in <root>/.dev-loop/. The project root is --root (default: cwd), never
this script's location. A relative --root resolves the same from anywhere in a git
checkout: against the working directory, then its git toplevel (resolve_root). The library location IS this script's location, and the
script injects it into the runner JVM itself (-Sdeps alias :kaocha-sublime/library,
appended last), so a repo alias never names this library's path and worktrees work.
Uses the installed clj-nrepl-eval client, not a bencode copy.
"""
import argparse
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import time
import uuid

LIBRARY = Path(__file__).resolve().parent.parent
RUNNER_NS = 'kaocha-sublime.runner'
GENERATION_PROP = '-Ddev.loop.generation='
ROOT_PROP = '-Ddev.loop.root='
LIBRARY_ALIAS = ':kaocha-sublime/library'
# What kaocha-sublime.runner needs beyond the library's own deps.edn (Clojure, Kaocha).
# Pinned here, in a fingerprinted file, so a version change forces a JVM restart.
RUNNER_DEPS = (('nrepl/nrepl', '1.3.1'), ('org.clojure/tools.namespace', '1.5.0'))


# ---------------------------------------------------------------- launch command

def library_sdeps(library=LIBRARY):
    """EDN for -Sdeps: one alias that adds THIS library (absolute path), the runner's
    deps, and the runner main. Appended last to -M so its :main-opts win and its
    local/kaocha-sublime coordinate overrides any relative one in a repo alias."""
    deps = ' '.join(name + ' {:mvn/version ' + json.dumps(version) + '}'
                    for name, version in RUNNER_DEPS)
    return ('{:aliases {' + LIBRARY_ALIAS + ' {:extra-deps {local/kaocha-sublime {:local/root ' +
            json.dumps(str(library)) + '} ' + deps + '} :main-opts ["-m" "' + RUNNER_NS + '"]}}}')


def runner_command(root, aliases, generation, library=LIBRARY):
    return ['clojure', '-Sdeps', library_sdeps(library), '-J-Xms64m', '-J-Xmx512m',
            '-J' + GENERATION_PROP + generation, '-J' + ROOT_PROP + str(root),
            '-M' + aliases + LIBRARY_ALIAS]


def default_aliases(root):
    """:test, plus the repo's optional :sublime alias (project extras) when deps.edn
    defines one. A textual check: an alias key at the start of a line."""
    text = (root / 'deps.edn').read_text() if (root / 'deps.edn').is_file() else ''
    return ':test:sublime' if re.search(r'(?m)^[\s{]*:sublime[\s{]', text) else ':test'


# ---------------------------------------------------------------- fingerprints

def fingerprint(root):
    h = hashlib.sha256()
    files = [p for p in (root / 'deps.edn', root / 'tests.edn') if p.is_file()]
    for folder in ('src', 'test', 'dev', 'resources'):
        if (root / folder).is_dir():
            files.extend(p for p in (root / folder).rglob('*') if p.is_file())
    for p in sorted(files):
        h.update(str(p.relative_to(root)).encode())
        h.update(p.read_bytes())
    return h.hexdigest()


class EdnError(ValueError):
    pass


class EdnReader:
    """A small EDN reader for config files (deps.edn, tests.edn). Values come back as
    tagged tuples ('map', ...), ('vec', ...), ('tok', text) ... that only feed
    canonical(); comments, whitespace, commas, #_ discards and ^metadata are dropped."""
    DELIMITERS = set('()[]{}"; \t\n\r,')
    CLOSERS = {'(': ')', '[': ']', '{': '}'}

    def __init__(self, text):
        self.s, self.i = text, 0

    def skip(self):
        s = self.s
        while self.i < len(s):
            c = s[self.i]
            if c in ' \t\n\r,\f':
                self.i += 1
            elif c == ';':
                end = s.find('\n', self.i)
                self.i = len(s) if end < 0 else end + 1
            elif s.startswith('#_', self.i):
                self.i += 2
                self.read()
            else:
                return

    def token(self):
        start = self.i
        while self.i < len(self.s) and self.s[self.i] not in self.DELIMITERS:
            self.i += 1
        if self.i == start:
            raise EdnError('empty token at ' + str(start))
        return self.s[start:self.i]

    def string(self):
        start = self.i = self.i + 1
        while self.i < len(self.s):
            c = self.s[self.i]
            if c == '\\':
                self.i += 2
            elif c == '"':
                self.i += 1
                return self.s[start:self.i - 1]
            else:
                self.i += 1
        raise EdnError('unterminated string')

    def items(self, closer):
        out = []
        while True:
            self.skip()
            if self.i >= len(self.s):
                raise EdnError('missing ' + closer)
            if self.s[self.i] == closer:
                self.i += 1
                return out
            out.append(self.read())

    def read(self):
        self.skip()
        s = self.s
        if self.i >= len(s):
            raise EdnError('unexpected end of input')
        c = s[self.i]
        if c in self.CLOSERS:
            self.i += 1
            items = self.items(self.CLOSERS[c])
            if c == '{':
                if len(items) % 2:
                    raise EdnError('map with an odd number of forms')
                return ('map', list(zip(items[::2], items[1::2])))
            return ('vec' if c == '[' else 'list', items)
        if c in ')]}':
            raise EdnError('unmatched ' + c)
        if c == '"':
            return ('str', self.string())
        if c == '\\':
            self.i += 1
            first = s[self.i:self.i + 1]
            if not first:
                raise EdnError('bad character literal')
            self.i += 1
            rest = self.token() if self.i < len(s) and s[self.i] not in self.DELIMITERS else ''
            return ('char', first + rest)
        if c == '^':
            self.i += 1
            self.read()  # metadata does not change the value
            return self.read()
        if c == '#':
            nxt = s[self.i + 1:self.i + 2]
            if nxt == '{':
                self.i += 2
                return ('set', self.items('}'))
            if nxt == '"':
                self.i += 1
                return ('regex', self.string())
            if nxt == '#':
                self.i += 2
                return ('tok', '##' + self.token())
            if nxt == ':':
                self.i += 1
                return ('nsmap', self.token(), self.read())
            self.i += 1
            return ('tag', self.token(), self.read())
        return ('tok', self.token())


def read_edn(text):
    reader = EdnReader(text)
    value = reader.read()
    reader.skip()
    if reader.i != len(text):
        raise EdnError('more than one top-level form')
    return value


def canonical(value):
    """A deterministic text for a read EDN value: map entries and set members sorted."""
    kind = value[0]
    if kind == 'map':
        return '{' + ' '.join(sorted(canonical(k) + ' ' + canonical(v) for k, v in value[1])) + '}'
    if kind == 'set':
        return '#{' + ' '.join(sorted(canonical(v) for v in value[1])) + '}'
    if kind in ('vec', 'list'):
        open_, close = ('[', ']') if kind == 'vec' else ('(', ')')
        return open_ + ' '.join(canonical(v) for v in value[1]) + close
    if kind == 'str':
        return '"' + value[1] + '"'
    if kind == 'regex':
        return '#"' + value[1] + '"'
    if kind == 'char':
        return '\\' + value[1]
    if kind in ('tag', 'nsmap'):
        return '#' + value[1] + ' ' + canonical(value[2])
    return value[1]


def alias_names(aliases):
    """':test:sublime' -> [':test', ':sublime']."""
    return [':' + name for name in aliases.split(':') if name]


# INTENT: LOOP-ENV-FINGERPRINT-004
def deps_basis(text, aliases):
    """The part of deps.edn that decides the runner JVM, as canonical EDN text: every
    top-level key except :aliases (:deps, :paths, :mvn/repos ...), and of :aliases only
    the aliases this runner uses, plus any vector-valued alias (an alias that names
    paths, usable from :paths). Comments, whitespace, key order and unused aliases do
    not count. Raises EdnError when the text does not read as one EDN map."""
    value = read_edn(text)
    if value[0] != 'map':
        raise EdnError('deps.edn is not a map')
    used = set(alias_names(aliases))
    parts = []
    for key, val in value[1]:
        if canonical(key) != ':aliases':
            parts.append(('top', canonical(key), canonical(val)))
            continue
        if val[0] != 'map':
            parts.append(('top', ':aliases', canonical(val)))
            continue
        for alias, body in val[1]:
            name = canonical(alias)
            if name in used or body[0] == 'vec':
                parts.append(('alias', name, canonical(body)))
    return json.dumps(sorted(parts))


def config_basis(name, data, aliases):
    """What to hash for deps.edn / tests.edn: canonical EDN of what affects the runner,
    or, when the file does not read as EDN, its bytes (any edit then restarts)."""
    try:
        text = data.decode('utf-8')
        if name == 'deps.edn':
            return b'edn:' + deps_basis(text, aliases).encode()
        return b'edn:' + canonical(read_edn(text)).encode()
    except (UnicodeDecodeError, EdnError, IndexError, RecursionError):
        return b'bytes:' + data


def environment_fingerprint(root, aliases=None):
    """Anything that requires a JVM restart: what the repo's deps.edn says about the
    runner classpath for these aliases, tests.edn (both parsed, so comments and
    whitespace do not count), and this library's own files (bytes)."""
    aliases = default_aliases(root) if aliases is None else aliases
    h = hashlib.sha256()
    h.update(('aliases ' + aliases).encode())
    for name in ('deps.edn', 'tests.edn'):
        p = root / name
        h.update(name.encode())
        h.update(config_basis(name, p.read_bytes(), aliases) if p.is_file() else b'<absent>')
    library_files = [LIBRARY / 'deps.edn', LIBRARY / 'bin' / 'sublime-loop',
                     *(LIBRARY / 'src').rglob('*.clj')]
    for p in sorted(library_files):
        h.update(str(p.relative_to(LIBRARY)).encode())
        h.update(p.read_bytes())
    return h.hexdigest()


# ---------------------------------------------------------------- liveness probes

def git_toplevel(cwd):
    """The git checkout top of `cwd`, or None outside git."""
    try:
        done = subprocess.run(['git', '-C', str(cwd), 'rev-parse', '--show-toplevel'],
                              capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return Path(done.stdout.strip()).resolve() if done.returncode == 0 and done.stdout.strip() else None


def resolve_root(arg, cwd):
    """The project root named by --root: as given (absolute, or against `cwd`), else, for a
    relative name, against the git toplevel of `cwd`. The first with a deps.edn wins, so
    `--root server2` means the same checkout directory from the top, from inside server2/ and
    from a sibling. Raises naming every path tried."""
    given = Path(arg)
    tried = [(cwd / given).resolve()]
    top = None if given.is_absolute() else git_toplevel(cwd)
    if top is not None:
        tried.append((top / given).resolve())
    for candidate in dict.fromkeys(tried):
        if (candidate / 'deps.edn').is_file():
            return candidate
    raise RuntimeError('not a Clojure project root (no deps.edn): --root ' + str(arg) + '; tried ' +
                       ', '.join(str(c) for c in dict.fromkeys(tried)))


FAILURE_LIMIT = 3
FIELD_LIMIT = 600
FAILURE_FIELDS = ('kind', 'test', 'expr', 'expected', 'actual', 'context')


def failure_summary(events_path, limit=FAILURE_LIMIT):
    """The first `limit` failures and errors of a check, from its events file (lines
    'FAIL {json}'), so the receipt shows what broke: test, file:line, expression, expected,
    actual and context. Long values are cut at FIELD_LIMIT. [] when there is nothing to read."""
    if not events_path:
        return []
    try:
        lines = Path(events_path).read_text().splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        kind, _, payload = line.partition(' ')
        if kind not in ('FAIL', 'ERROR'):
            continue
        try:
            event = json.loads(payload)
        except ValueError:
            continue
        item = {}
        for key in FAILURE_FIELDS:
            value = event.get(key)
            if value in (None, '', []):
                continue
            value = value if isinstance(value, str) else json.dumps(value)
            item[key] = value if len(value) <= FIELD_LIMIT else value[:FIELD_LIMIT] + '…'
            if key == 'test' and event.get('file'):
                item['at'] = event['file'] + (':' + str(event['line']) if event.get('line') else '')
        out.append({k: item[k] for k in ('kind', 'test', 'at', 'expr', 'expected', 'actual', 'context') if k in item})
        if len(out) >= limit:
            break
    return out


# A check target: a namespace, or one test var in it (my.app-test/adds-two?).
TARGET = re.compile(r"[A-Za-z][A-Za-z0-9_.-]*(/[A-Za-z0-9_*+!?<>=.'-]+)?")


def valid_target(name):
    return TARGET.fullmatch(name) is not None


def one_line(value, limit=200):
    text = ' '.join(str(value).split())
    return text if len(text) <= limit else text[:limit] + '...'


def render_failures(receipt):
    """A short human-readable block for a failed check (stderr), so a terminal run is
    readable without jq: one stanza per failure with test, file:line, message and
    expected/actual one-liners, plus the last lines of the test's output. '' when the
    check passed or carried nothing to show."""
    if receipt.get('status') not in ('fail', 'stale', 'unknown', 'unverified'):
        return ''
    out = []
    counts = receipt.get('counts') or {}
    failures = receipt.get('failures') or []
    if counts:
        out.append('test-focus: %s -- %s tests, %s fail, %s error' % (
            receipt.get('status', '').upper(), counts.get('tests'), counts.get('fail'), counts.get('error')))
    if receipt.get('error') and not failures:
        stage = ' at stage ' + receipt['stage'] if receipt.get('stage') else ''
        out.append('test-focus: %s%s: %s' % (receipt.get('status', '').upper(), stage,
                                              one_line(receipt['error'], 600)))
    for item in failures:
        out.append('')
        out.append('%s %s  %s' % (item.get('kind', 'fail').upper(), item.get('test', '?'), item.get('at', '')))
        for key in ('message', 'context', 'expr', 'expected', 'actual'):
            if item.get(key):
                # A stale entry's message is the whole diagnosis and ends with the repair.
                limit = 400 if item.get('kind') == 'stale' and key == 'message' else 200
                out.append('  %-9s %s' % (key + ':', one_line(item[key], limit)))
        if item.get('output'):
            lines = item['output'].rstrip('\n').splitlines()
            out.append('  output:   (last %d of %d lines)' % (min(5, len(lines)), len(lines)))
            out.extend('    | ' + one_line(line, 160) for line in lines[-5:])
    omitted = receipt.get('failures-omitted') or 0
    if omitted:
        out.append('')
        out.append('... %d more failures not shown; see the Kaocha receipt at %s' % (omitted, receipt.get('path')))
    return '\n'.join(out) + '\n' if out else ''


# Above this 1-minute load per core a timing measures the machine (docs/SETUP.md section 14).
BUSY_PER_CORE = 1.5


# INTENT: LOOP-RECEIPT-LOAD-SLOWEST-006
def render_load_line(receipt):
    """One line for every check: the 1-minute load at the start (and end) of the check
    and the slowest test var that ran."""
    load, cpus, end = receipt.get('load_1m'), receipt.get('cpus'), receipt.get('load_1m_end')
    if load is None:
        text = 'test-focus: load unknown'
    else:
        per_core = receipt.get('per_core')
        text = 'test-focus: load %s on %s cpus (%s/core)' % (load, cpus, per_core)
        if end is not None:
            text += ', %s at end' % end
        if per_core is not None and per_core > BUSY_PER_CORE:
            text += ' [busy: timings measure the machine]'
    slow = receipt.get('slowest') or []
    if slow:
        text += '; slowest %s %s ms' % (slow[0].get('test'), slow[0].get('ms'))
    return text + '\n'


# INTENT: LOOP-PERF-MODE-008
def render_perf(receipt):
    """Every ^:perf test that ran with its duration and outcome, in run order."""
    if 'perf-tests' not in receipt:
        return ''
    tests = receipt.get('perf-tests') or []
    out = ['test-focus: PERF -- %d timing tests' % len(tests)]
    out.extend('  %10s ms  %-7s %s' % (t.get('ms'), t.get('outcome'), t.get('test')) for t in tests)
    return '\n'.join(out) + '\n'


# INTENT: LOOP-REPEAT-007
def render_repeat(receipt):
    """The verdict of a repeated check and every test that was not a stable pass."""
    rep = receipt.get('repeat')
    if not rep:
        return ''
    out = ['test-focus: REPEAT %d of %d runs -- %s (%d flaky, %d stable-fail, %d stable-pass)' % (
        rep['runs'], rep['requested'], rep['verdict'], rep['flaky'], rep['stable_fail'], rep['stable_pass'])]
    for row in rep['tally']:
        if row['verdict'] != 'stable-pass':
            out.append('  %-11s %s  %d/%d pass' % (row['verdict'], row['test'], row['pass'], row['runs']))
    if rep.get('source_changed'):
        out.append('  source files changed between runs: the tally spans more than one version')
    return '\n'.join(out) + '\n'


# INTENT: LOOP-STALE-REFER-011
def render_stale(receipt):
    """One line each for definitions the reload removed (or found stale and kept) without
    any namespace still mapping them: a warning, the verdict is unchanged."""
    stale = receipt.get('stale') or {}
    defs = stale.get('defs') or []
    out = []
    removed = [d for d in defs if d.get('unmapped')]
    kept = [d for d in defs if not d.get('unmapped')]
    if removed:
        names = ', '.join('%s/%s' % (d.get('ns'), d.get('var')) for d in removed[:5])
        more = ' and %d more' % (len(removed) - 5) if len(removed) > 5 else ''
        out.append('test-focus: unmapped %d definition(s) the files no longer have: %s%s' % (len(removed), names, more))
    if kept:
        out.append('test-focus: %d stale definition(s) survive in the warm image (defined by another file, '
                   'not referenced); see receipt stale.defs' % len(kept))
    for r in stale.get('repaired') or []:
        out.append('test-focus: repaired %s/%s: %s -> %s' % (r.get('ns'), r.get('var'), r.get('was') or 'unmapped',
                                                             r.get('now') or 'unmapped'))
    return '\n'.join(out) + '\n' if out else ''


def render_check(receipt):
    """The whole stderr block of a check: load line, perf timings, repeat tally, stale image,
    failures."""
    return (render_load_line(receipt) + render_perf(receipt) + render_repeat(receipt) + render_stale(receipt)
            + render_failures(receipt))


# INTENT: LOOP-REPEAT-007
def repeat_tally(runs):
    """Per-test outcome counts across runs (each run a list of {'test', 'outcome'}), and the
    verdict: a test is stable-pass when every run passed it, stable-fail when none did, flaky
    otherwise. Pending outcomes are not counted. Rows: flaky, then stable-fail, then
    stable-pass, each by name."""
    rows = {}
    for timings in runs:
        for t in timings:
            if t.get('outcome') == 'pending':
                continue
            row = rows.setdefault(t['test'], {'test': t['test'], 'runs': 0, 'pass': 0, 'fail': 0, 'error': 0})
            row['runs'] += 1
            row[t['outcome'] if t.get('outcome') in ('pass', 'fail', 'error') else 'error'] += 1
    for row in rows.values():
        row['verdict'] = ('stable-pass' if row['pass'] == row['runs'] else
                          'stable-fail' if row['pass'] == 0 else 'flaky')
    order = {'flaky': 0, 'stable-fail': 1, 'stable-pass': 2}
    return sorted(rows.values(), key=lambda r: (order[r['verdict']], r['test']))


def repeat_verdict(tally, statuses):
    """flaky when any test (or the run status) changed between runs; else stable-fail when any
    test or run failed; else stable-pass. A stale run (files changed under it) still ran its
    tests: its tally counts, its status does not."""
    statuses = [s for s in statuses if s != 'stale']
    if any(r['verdict'] == 'flaky' for r in tally) or len(set(statuses)) > 1:
        return 'flaky'
    if any(r['verdict'] == 'stable-fail' for r in tally) or any(s != 'pass' for s in statuses):
        return 'stable-fail'
    return 'stable-pass'


REPEAT_MAX = 50
SLOWEST_DEFAULT = 5
SLOWEST_MAX = 50


# INTENT: LOOP-RELOAD-FAILURE-005
# INTENT: LOOP-STALE-REFER-011
def reload_failure_is_terminal(receipt):
    """A check that failed to reload or scan, or found a stale image (mappings that no
    longer match the files), in a JVM the runner says is still usable, is a terminal fail
    that leaves the runner warm: the next check reloads the whole closure again (and
    --repair-stale repairs a stale image inside it)."""
    return (receipt.get('status') == 'fail'
            and receipt.get('stage') in ('reload', 'dependency-scan', 'stale-image')
            and receipt.get('jvm-usable') is True)


def probe_process(pid):
    """Facts about pid from ps: exists, zombie, full command line."""
    stat = subprocess.run(['ps', '-p', str(pid), '-o', 'stat='], text=True, capture_output=True)
    state = stat.stdout.strip()
    if not state:
        return {'exists': False, 'zombie': False, 'command': ''}
    command = subprocess.run(['ps', '-ww', '-p', str(pid), '-o', 'command='],
                             text=True, capture_output=True).stdout.strip()
    return {'exists': True, 'zombie': state.startswith('Z'), 'command': command}


def port_listeners(port):
    """PIDs LISTENing on TCP port. Raises when lsof itself is unavailable or errs."""
    if not shutil.which('lsof'):
        raise RuntimeError('lsof is required to prove nREPL port ownership')
    result = subprocess.run(['lsof', '-nP', '-iTCP:' + str(port), '-sTCP:LISTEN', '-Fp'],
                            text=True, capture_output=True)
    if result.returncode not in (0, 1):
        raise RuntimeError('lsof failed: ' + result.stderr.strip())
    return {int(line[1:]) for line in result.stdout.splitlines() if line.startswith('p')}


def classify(session, root, probe=probe_process, listeners=port_listeners):
    """Decide whether a session record names a live runner, without trusting the record.

    Returns {'state': 'live'|'stale', 'reason': str, 'owned': bool}. 'owned' means the
    recorded pid is a live java whose command line carries this record's generation
    marker: only an owned process may ever be signalled. 'live' additionally requires
    that pid to own the recorded nREPL port; nREPL attestation happens afterwards.
    """
    pid, port, generation = session.get('pid'), session.get('port'), session.get('generation')
    if not isinstance(pid, int) or not isinstance(port, int) or not generation:
        return {'state': 'stale', 'reason': 'malformed-record', 'owned': False}
    facts = probe(pid)
    if not facts['exists'] or facts['zombie']:
        return {'state': 'stale', 'reason': 'process-gone', 'owned': False}
    command = facts['command']
    is_java = re.search(r'(^|/)java(\s|$)', command) is not None
    owned = is_java and (GENERATION_PROP + generation) in command
    if not owned:
        return {'state': 'stale', 'reason': 'pid-not-this-runner', 'owned': False}
    if pid not in listeners(port):
        return {'state': 'stale', 'reason': 'port-not-owned', 'owned': True}
    return {'state': 'live', 'reason': 'owned-and-listening', 'owned': True}


PROBE_BASE_S = 5
PROBE_MAX_S = 20
PROBE_SCALE_MAX = 6.0


def load_per_core(getloadavg=os.getloadavg, cpus=os.cpu_count):
    """{'load_1m', 'cpus', 'per_core'}; per_core None when the load cannot be read."""
    count = cpus() or 1
    try:
        load = getloadavg()[0]
    except (OSError, AttributeError):
        return {'load_1m': None, 'cpus': count, 'per_core': None}
    return {'load_1m': round(load, 2), 'cpus': count, 'per_core': round(load / count, 2)}


# INTENT: LOOP-PROBE-UNVERIFIED-003
def probe_budget(per_core):
    """How long and how often to wait for a liveness answer from the warm JVM at this
    1-minute load per core (None = unknown, treated as busy). Bounded: at most 3
    attempts of at most PROBE_MAX_S each, so a probe never outlasts the lock wait."""
    per_core = 1.0 if per_core is None else max(0.0, per_core)
    scale = min(PROBE_SCALE_MAX, 1.0 + per_core)
    attempts = 2 if per_core < 1 else 3
    return {'timeout_s': min(PROBE_MAX_S, int(round(PROBE_BASE_S * scale))),
            'client_margin_s': min(10, int(round(3 * scale))),
            'attempts': attempts,
            'backoff_s': [min(4, 2 ** n) for n in range(attempts - 1)]}


class NoReceipt(RuntimeError):
    """The nREPL request produced no terminal receipt (timeout, refused, client error)."""

    def __init__(self, message, response_path=None, request_id=None):
        super().__init__(message)
        self.response_path, self.request_id = response_path, request_id


class Unverified(RuntimeError):
    """A recorded runner whose process and port are proven ours did not answer nREPL.
    Neither live nor dead: never replaced by a second JVM, never reported as ready."""

    def __init__(self, message, evidence):
        super().__init__(message)
        self.evidence = evidence


def utc_stamp():
    return datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')


def archive_session(run_dir, session_path, pid, clock=utc_stamp):
    """Move the record to session.stale-<pid>-<UTC>.json; never overwrite, never delete."""
    data = session_path.read_bytes()
    base = 'session.stale-' + str(pid) + '-' + clock()
    for n in range(1000):
        candidate = run_dir / (base + ('' if n == 0 else '-' + str(n)) + '.json')
        try:
            with candidate.open('xb') as out:
                out.write(data)
                out.flush()
                os.fsync(out.fileno())
        except FileExistsError:
            continue
        session_path.unlink()
        return candidate
    raise RuntimeError('could not choose an unused archive name for ' + base)


# ---------------------------------------------------------------- nREPL transport

def read_transport(path, request_id):
    receipt = json.loads(path.read_text())
    if receipt.get('request-id') != request_id:
        raise RuntimeError('terminal receipt request mismatch')
    return receipt['value']


class Loop:
    def __init__(self, root, aliases, env, explicit_aliases=False):
        self.load = load_per_core
        self.sleep = time.sleep
        self.root = root
        self.aliases = aliases
        self.explicit_aliases = explicit_aliases
        self.env = env
        self.run = root / '.dev-loop'
        self.session_path = self.run / 'session.json'
        self.taint = self.run / 'tainted'

    def evaluate(self, session, expression, timeout=120, margin=3):
        # Nonce-bound receipt (curtaincall variant): a unique, atomically published
        # file survives test stdout capture, and the request-id binds the result to
        # this exact request, never a prior green.
        request_id = str(uuid.uuid4())
        response_path = self.run / ('transport-' + request_id + '.json')
        temporary_path = response_path.with_suffix('.tmp')
        code = ('(let [value ' + expression + '] '
                '(spit ' + json.dumps(str(temporary_path)) +
                ' (' + RUNNER_NS + '/write-json {:request-id ' + json.dumps(request_id) +
                ' :value value})) '
                '(java.nio.file.Files/move (.toPath (clojure.java.io/file ' +
                json.dumps(str(temporary_path)) + ')) (.toPath (clojure.java.io/file ' +
                json.dumps(str(response_path)) + ')) (into-array java.nio.file.CopyOption '
                '[java.nio.file.StandardCopyOption/ATOMIC_MOVE])) '
                '(println "DEV_LOOP_RESULT_SAVED"))')
        try:
            result = subprocess.run(['clj-nrepl-eval', '--port', str(session['port']),
                                     '--timeout', str(timeout * 1000), code], cwd=self.root,
                                    text=True, capture_output=True, timeout=timeout + margin)
            detail = (result.stderr or result.stdout)[-1600:]
        except subprocess.TimeoutExpired:
            detail = 'clj-nrepl-eval timed out after ' + str(timeout + margin) + 's'
        if response_path.exists():
            return read_transport(response_path, request_id)
        raise NoReceipt('nREPL returned no terminal receipt: ' + detail, response_path, request_id)

    def attest(self, session, spawned=False):
        """Ask the runner who it is. Under load a probe can time out while the runner is
        fine, so the wait and the retries scale with the load per core, and a late answer
        to an earlier attempt counts. No answer at all raises Unverified, never a guess."""
        load = self.load()
        budget = probe_budget(load['per_core'])
        attempts, pending, actual = [], [], None
        started = time.monotonic()
        for n in range(budget['attempts']):
            if n:
                self.sleep(budget['backoff_s'][n - 1])
            actual = self.late_answer(pending)
            if actual is not None:
                break
            t0 = time.monotonic()
            try:
                actual = self.evaluate(session, RUNNER_NS + '/identity-data',
                                       timeout=budget['timeout_s'], margin=budget['client_margin_s'])
                break
            except NoReceipt as exc:
                attempts.append({'attempt': n + 1, 'elapsed_s': round(time.monotonic() - t0, 2),
                                 'detail': one_line(exc, 300)})
                pending.append((exc.response_path, exc.request_id))
        if actual is None:
            actual = self.late_answer(pending)
        if actual is None:
            evidence = {'pid': session.get('pid'), 'port': session.get('port'),
                        'generation': session.get('generation'),
                        'process': 'spawned by this command' if spawned else 'alive, java, generation marker in its command line',
                        'port_owner': session.get('pid') if not spawned else None,
                        'nrepl': 'no answer to ' + str(len(attempts)) + ' identity probes',
                        'attempts': attempts, 'budget': budget,
                        'probe_s': round(time.monotonic() - started, 2), **load}
            raise Unverified('warm JVM pid %s (port %s) is alive%s but did not answer nREPL: '
                             '%d probes of %ds at load %s/core; not starting another JVM. Retry '
                             'when the load drops, or `sublime-loop down` then `up` to replace it'
                             % (session.get('pid'), session.get('port'),
                                '' if spawned else ' and owns its port', len(attempts),
                                budget['timeout_s'], load['per_core']), evidence)
        for key in ('root', 'pid', 'generation', 'role'):
            if actual.get(key) != session.get(key):
                raise RuntimeError('runtime identity mismatch: ' + key)
        if actual['root'] != str(self.root) or actual['role'] != 'test-only':
            raise RuntimeError('wrong worktree or runtime role')
        return actual

    def late_answer(self, pending):
        """The identity value from an earlier probe whose answer arrived after it timed out."""
        for path, request_id in pending:
            if path is not None and path.exists():
                try:
                    return read_transport(path, request_id)
                except (OSError, ValueError, KeyError, RuntimeError):
                    continue
        return None

    def load_session(self, attest=True):
        """Return (session, stale_archive). A stale record is archived, never trusted.
        attest=False (down) trusts the ps/lsof ownership proof alone, so an owned runner
        that no longer answers nREPL can still be stopped."""
        if not self.session_path.exists():
            return None, None
        session = json.loads(self.session_path.read_text())
        verdict = classify(session, self.root)
        if verdict['state'] == 'stale':
            archive = archive_session(self.run, self.session_path, session.get('pid'))
            if verdict['owned']:
                # Our generation's JVM, alive but not serving its recorded port. It is
                # proven ours, so stop it rather than orphan a heap.
                self.terminate(session['pid'])
            self.taint.unlink(missing_ok=True)
            return None, {'path': str(archive), 'reason': verdict['reason']}
        # Alive and owned: attest via nREPL. A runner that does not answer is Unverified
        # and keeps its record: it is never archived, replaced or reported as ready.
        if attest:
            self.attest(session)
        return session, None

    def terminate(self, pid):
        os.kill(pid, signal.SIGTERM)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            facts = probe_process(pid)
            if not facts['exists'] or facts['zombie']:
                return
            time.sleep(.05)
        raise RuntimeError('owned process has not stopped; session identity retained')

    def require_aliases(self, session):
        # A live session started with other aliases runs another classpath; refuse
        # rather than certify it as ready or test on it.
        if self.explicit_aliases and session.get('aliases') != self.aliases:
            raise RuntimeError('runner or dependencies changed (aliases ' +
                               str(session.get('aliases')) + ' -> ' + self.aliases +
                               '); run sublime-loop down then up')

    def boot(self):
        session, stale = self.load_session()
        if session is not None:
            if self.taint.exists():
                raise RuntimeError('test process tainted; run sublime-loop down then up')
            self.require_aliases(session)
            return session, None
        if not shutil.which('clj-nrepl-eval'):
            raise RuntimeError('install clj-nrepl-eval before starting the runner')
        generation = str(uuid.uuid4())
        env = dict(os.environ, DEV_LOOP_GENERATION=generation)
        env.update(self.env)
        command = runner_command(self.root, self.aliases, generation)
        with (self.run / 'boot.log').open('w') as log:
            process = subprocess.Popen(command, cwd=self.root, env=env, stdout=log,
                                       stderr=subprocess.STDOUT, start_new_session=True)
        deadline = time.monotonic() + 90
        while time.monotonic() < deadline:
            if self.session_path.exists():
                session = json.loads(self.session_path.read_text())
                if session['generation'] != generation:
                    raise RuntimeError('unexpected generation during startup')
                # Record what this JVM was started with first: if the attest below goes
                # unanswered under load, the record still describes it for the next probe.
                session['environment'] = environment_fingerprint(self.root, self.aliases)
                session['aliases'] = self.aliases
                tmp = self.run / 'session.json.tmp'
                tmp.write_text(json.dumps(session))
                tmp.replace(self.session_path)
                self.taint.unlink(missing_ok=True)
                self.attest(session, spawned=True)
                return session, stale
            if process.poll() is not None:
                raise RuntimeError('startup failed; see ' + str(self.run / 'boot.log'))
            time.sleep(.1)
        # This process group was created and is owned by this exact invocation.
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=10)
        raise RuntimeError('startup exceeded 90 seconds; owned process stopped; see boot.log')

    def command(self, command, names, options=None):
        if command == 'up':
            session, stale = self.boot()
            receipt = dict(session, status='ready')
            if stale:
                receipt.update(stale_record=stale['path'], stale_reason=stale['reason'])
            return receipt
        session, stale = self.load_session(attest=False) if command == 'down' else self.load_session()
        if session is None:
            if stale and command in ('status', 'down'):
                return {'status': 'stopped', 'stale_record': stale['path'],
                        'stale_reason': stale['reason']}
            suffix = ' (stale record archived to ' + stale['path'] + ')' if stale else ''
            raise RuntimeError('no owned test process; run sublime-loop up' + suffix)
        if command == 'down':
            self.terminate(session['pid'])
            self.session_path.unlink()
            self.taint.unlink(missing_ok=True)
            return {'status': 'stopped', 'pid': session['pid']}
        if command == 'status':
            return dict(session, status='tainted' if self.taint.exists() else 'ready')
        if command == 'check':
            return self.check(session, names, **(options or {}))
        raise RuntimeError('use up, status, check or down')

    def run_once(self, session, names, reload, perf, slowest, timings, repair_stale=False):
        """One runner check!: taint while in flight, untaint on a terminal result."""
        before = fingerprint(self.root)
        self.taint.write_text('check in flight; terminal result not yet received\n')
        options = '{:reload %s :perf %s :slowest %d :timings %s}' % (
            'true' if reload else 'false', 'true' if perf else 'false', slowest, 'true' if timings else 'false')
        if repair_stale:
            # INTENT: LOOP-STALE-REPAIR-012
            options = options[:-1] + ' :repair-stale true}'
        receipt = self.evaluate(session, '(' + RUNNER_NS + '/check! ' + json.dumps(names) + ' ' + options + ')')
        after = fingerprint(self.root)
        # A focus refusal (a named test var does not exist, or no ^:perf var) comes after
        # a complete reload and runs nothing, so it leaves a clean image: terminal, untainted.
        # A failed reload or dependency scan runs nothing and is reported as fail; the
        # runner says whether the JVM is still usable (older runners do not: tainted).
        if receipt.get('reload-failure') and receipt.get('status') == 'pass':
            receipt['status'] = 'fail'
        terminal = ((receipt.get('status') in ('pass', 'fail') and receipt.get('counts') is not None)
                    or (receipt.get('status') == 'fail' and receipt.get('stage') == 'focus')
                    or reload_failure_is_terminal(receipt))
        if before != after:
            receipt['status'] = 'stale'
        if terminal:
            self.taint.unlink()
        else:
            self.taint.write_text('probe did not establish a completed test result; restart owned runner\n')
        # The runner builds full failure details from the live result tree; an
        # older runner did not, so fall back to the events file summary.
        if not isinstance(receipt.get('failures'), list):
            failures = failure_summary(receipt.get('events'))
            if failures:
                receipt['failures'] = failures
        return receipt, before, after, terminal

    def check(self, session, names, repeat=1, perf=False, slowest=SLOWEST_DEFAULT, repair_stale=False):
        if (not names and not perf) or any(not valid_target(n) for n in names):
            raise RuntimeError('name explicit test namespaces or test vars: sublime-loop check '
                               'project.core-test project.db-test/reads-rows')
        if not (isinstance(repeat, int) and 1 <= repeat <= REPEAT_MAX):
            raise RuntimeError('--repeat must be a whole number from 1 to %d' % REPEAT_MAX)
        if not (isinstance(slowest, int) and 0 <= slowest <= SLOWEST_MAX):
            raise RuntimeError('--slowest must be a whole number from 0 to %d' % SLOWEST_MAX)
        if self.taint.exists():
            raise RuntimeError('test process tainted; restart the owned runner')
        if session.get('environment') != environment_fingerprint(self.root, self.aliases):
            raise RuntimeError('runner or dependencies changed; run sublime-loop down then up')
        self.require_aliases(session)
        if repeat == 1:
            receipt, before, _, _ = self.run_once(session, names, True, perf, slowest, False, repair_stale)
        else:
            receipt, before = self.repeat(session, names, repeat, perf, slowest, repair_stale)
        receipt.update(source=before, generation=session['generation'],
                       checks=names, verification_complete=False,
                       proof_pending=['final candidate required gates'])
        return receipt

    # INTENT: LOOP-REPEAT-007
    def repeat(self, session, names, n, perf, slowest, repair_stale=False):
        """Run the same check n times in this JVM. Only the first run reloads the dependency
        closure, unless the source fingerprint changed since that reload (the probe itself
        always reloads the target test namespaces, so state held there starts fresh). Stops early when a run gives no
        terminal result or no per-test outcomes (a reload failure or a focus refusal).
        The top-level fields are those of the first run that did not pass (else the last
        run); `repeat` carries the per-test tally and the verdict."""
        runs, outcomes, receipts = [], [], []
        first = loaded = None
        changed = False
        for index in range(n):
            # Reload when the files differ from those the last reload read, including an
            # edit that landed while the previous run was in flight.
            reload = index == 0 or fingerprint(self.root) != loaded
            receipt, before, after, terminal = self.run_once(session, names, reload, perf, slowest, True,
                                                             repair_stale)
            if first is None:
                first = before
            if reload:
                loaded = before
            changed = changed or before != first or after != before
            timings = receipt.pop('test-timings', None)
            receipts.append(receipt)
            runs.append({'run': index + 1, 'status': receipt.get('status'), 'reloaded': reload,
                         'tests': (receipt.get('counts') or {}).get('tests'),
                         'fail': (receipt.get('counts') or {}).get('fail'),
                         'error': (receipt.get('counts') or {}).get('error')})
            if not terminal or not isinstance(timings, list) or receipt.get('stage') != 'probe':
                break
            outcomes.append(timings)
        tally = repeat_tally(outcomes)
        statuses = [r['status'] for r in runs]
        complete = len(outcomes) == n
        verdict = repeat_verdict(tally, statuses) if complete else 'incomplete'
        base = next((r for r in receipts if r.get('status') != 'pass'), receipts[-1])
        receipt = dict(base)
        if complete:
            receipt['status'] = 'stale' if changed else ('pass' if verdict == 'stable-pass' else 'fail')
        receipt['repeat'] = {
            'requested': n, 'runs': len(runs), 'verdict': verdict, 'source_changed': changed,
            'flaky': sum(r['verdict'] == 'flaky' for r in tally),
            'stable_fail': sum(r['verdict'] == 'stable-fail' for r in tally),
            'stable_pass': sum(r['verdict'] == 'stable-pass' for r in tally),
            'tally': tally, 'per_run': runs}
        return receipt, first


def parse(argv):
    parser = argparse.ArgumentParser(prog='sublime-loop')
    parser.add_argument('--root', default='.', help='Clojure project root (has deps.edn)')
    parser.add_argument('--aliases', default=None,
                        help='deps aliases for the runner JVM (default :test, plus :sublime '
                             'when deps.edn defines it); the library alias is always appended')
    parser.add_argument('--env', action='append', default=[], metavar='KEY=VALUE',
                        help='extra runner env; {state_dir} expands to <root>/.dev-loop')
    parser.add_argument('--repeat', default='1', metavar='N',
                        help='check: run the selection N times (1-%d) and tally each test' % REPEAT_MAX)
    parser.add_argument('--perf', action='store_true',
                        help='check: run only ^:perf test vars (of the named namespaces, else of all '
                             'test namespaces), never fail-fast, with each duration')
    parser.add_argument('--slowest', default=str(SLOWEST_DEFAULT), metavar='N',
                        help='check: name the N slowest test vars in the receipt (0-%d)' % SLOWEST_MAX)
    parser.add_argument('--repair-stale', action='store_true',
                        help='check: when the reload leaves a stale image (a refer that did not take, a '
                             'namespace mapping a deleted var), ns-unmap, reload again and re-check')
    parser.add_argument('command', nargs='?', default='status')
    parser.add_argument('names', nargs='*')
    return parser.parse_args(argv)


def check_options(args):
    """The check options from the command line; a malformed number is a loop error."""
    out = {}
    for key, text in (('repeat', args.repeat), ('slowest', args.slowest)):
        if not re.fullmatch(r'[0-9]{1,3}', str(text)):
            raise RuntimeError('--%s must be a whole number' % key)
        out[key] = int(text)
    out['perf'] = bool(args.perf)
    if args.repair_stale:
        out['repair_stale'] = True
    return out


def main(argv=None):
    args = parse(sys.argv[1:] if argv is None else argv)
    root = resolve_root(args.root, Path.cwd())
    explicit = args.aliases is not None
    aliases = args.aliases if explicit else default_aliases(root)
    if not re.fullmatch(r'(:[A-Za-z0-9_.*+!?<>=/-]+)+', aliases):
        raise RuntimeError('--aliases must look like :test:dev')
    env = {}
    for item in args.env:
        key, sep, value = item.partition('=')
        if not sep or not key:
            raise RuntimeError('--env expects KEY=VALUE: ' + item)
        env[key] = value.replace('{state_dir}', str(root / '.dev-loop'))
    loop = Loop(root, aliases, env, explicit)
    loop.run.mkdir(exist_ok=True)
    start = time.monotonic()
    with (loop.run / 'lock').open('a') as lock:
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() - start > 120:
                    raise RuntimeError('runner busy for 120 seconds; existing owner retains the lock')
                time.sleep(.05)
        queue_s = time.monotonic() - start
        names = [n for arg in args.names for n in arg.split(',') if n]
        load = loop.load() if args.command == 'check' else None
        try:
            receipt = loop.command(args.command, names, check_options(args))
        except Unverified as exc:
            receipt = {'status': 'unverified', 'error': str(exc), 'evidence': exc.evidence,
                       'pid': exc.evidence.get('pid'), 'port': exc.evidence.get('port'),
                       'generation': exc.evidence.get('generation')}
        except Exception as exc:
            receipt = {'status': 'unknown', 'error': str(exc)}
        if load is not None:
            # INTENT: LOOP-RECEIPT-LOAD-SLOWEST-006
            receipt.update(load_1m=load['load_1m'], cpus=load['cpus'], per_core=load['per_core'],
                           load_1m_end=loop.load()['load_1m'])
        receipt.update(schema='dev-loop.v1', root=str(root), wall_s=round(time.monotonic() - start, 4),
                       queue_s=round(queue_s, 4))
        receipt_path = loop.run / ('result-' + str(uuid.uuid4()) + '.json')
        receipt['wrapper_receipt'] = str(receipt_path)
        payload = json.dumps(receipt, indent=2) + '\n'
        receipt_path.write_text(payload)
        latest = loop.run / 'last-result.tmp'
        latest.write_text(payload)
        latest.replace(loop.run / 'last-result.json')
        print(json.dumps(receipt))
        if args.command == 'check':
            sys.stderr.write(render_check(receipt))
        if receipt['status'] in ('unknown', 'unverified'):
            return 2
        return 0 if receipt['status'] in ('ready', 'stopped', 'pass') else 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as exc:
        print(json.dumps({'schema': 'dev-loop.v1', 'status': 'unknown', 'error': str(exc)}))
        sys.exit(2)
