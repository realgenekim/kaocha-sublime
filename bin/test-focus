#!/usr/bin/env bash
# test-focus -- run named test namespaces or test vars in the warm JVM for this project root.
#
#   test-focus my.app.core-test my.app.db-test
#   test-focus my.app.core-test/adds-two my.app.db-test     # one var, plus a whole namespace
#   test-focus --root server2 --aliases :run-tests:dev:test server2.handlers.discover-test
#   test-focus --repeat 10 my.app.core-test/flaky-one   # rerun 10x warm; tally + verdict
#   test-focus --perf                                    # every ^:perf test, load printed first
#   test-focus --perf my.app.render-test --slowest 10
#
# Thin wrapper over sublime-loop check. When no warm JVM is up, it is tainted, or its
# dependencies/runner/aliases changed, it says so LOUDLY on stderr ("COLD START"), starts
# or restarts the warm JVM, and then runs the check. Every cold start is visible: one per
# session is the cost of doing business; more than one means the inner loop is being paid
# for cold. A warm JVM that is alive and owns its port but does not answer nREPL in time
# (a loaded machine) is "unverified": test-focus says so (UNVERIFIED, exit 2) and never
# starts a second JVM for the root. Any other loop error is reported, not cold-started.
# A wrong --root is refused (exit 2) before any JVM starts; a relative --root
# resolves from anywhere in the checkout. A failing check's receipt carries "failures": each
# failing assertion with test var, file:line, message, expected, actual and the test's captured
# stdout/stderr; a readable block of the same goes to stderr after the JSON line.
# Every check receipt carries load_1m, cpus, per_core and load_1m_end, and "slowest" (the N
# slowest test vars, default 5, --slowest N); the block's first line shows the load and the
# slowest test. --repeat N (1-50) reruns the selection N times in the warm JVM, reloading only
# when files change, and reports a per-test tally and a verdict (stable-pass, stable-fail,
# flaky) in "repeat". --perf runs only the ^:perf test vars of the named namespaces (of all
# test namespaces when none is named), never fail-fast, and reports each duration in
# "perf-tests"; the load is printed before the run starts.
# Exit code is the check's: 0 pass, 1 fail/stale/tainted, 2 unknown.
# Pass the same --root/--aliases you gave warm-jvm. Docs: docs/SETUP.md in this library.
set -euo pipefail
LOOP="$(cd "$(dirname "$0")" && pwd)/sublime-loop"
flags=(); checkflags=(); names=(); perf=0
while [ $# -gt 0 ]; do
  case "$1" in
    --root|--aliases|--env)
      [ $# -ge 2 ] || { echo "test-focus: $1 needs a value" >&2; exit 2; }
      flags+=("$1" "$2"); shift 2 ;;
    --repeat|--slowest)
      [ $# -ge 2 ] || { echo "test-focus: $1 needs a value" >&2; exit 2; }
      checkflags+=("$1" "$2"); shift 2 ;;
    --perf) checkflags+=("$1"); perf=1; shift ;;
    *) names+=("$1"); shift ;;
  esac
done
[ ${#names[@]} -gt 0 ] || [ "$perf" -eq 1 ] || {
  echo "test-focus: name at least one test namespace or ns/test-var (or use --perf)" >&2; exit 2; }
# INTENT: LOOP-PERF-MODE-008
# A timing is only as good as the machine it ran on: say the load before the perf run starts.
if [ "$perf" -eq 1 ]; then
  echo "test-focus: --perf; load averages $(uptime | sed 's/.*load average[s]*: //') on" \
       "$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo '?') cpus, before the run" >&2
fi
# The check's human-readable failure block (stderr) is held until after the JSON line, so it
# is the last thing on screen rather than buried above one long line.
block="$(mktemp "${TMPDIR:-/tmp}/test-focus.XXXXXX")"
trap 'rm -f "$block"' EXIT
cold() { echo "test-focus: COLD START -- $1; starting the warm JVM (sublime-loop up)" >&2; }
unverified() {
  echo "test-focus: UNVERIFIED -- the warm JVM for this root is alive but did not answer nREPL" \
       "in time (machine under load?); not starting a second JVM. Evidence is in the receipt." >&2
  printf '%s\n' "$1"; exit 2
}
# Start/restart receipts go to stderr so stdout carries exactly one receipt: the check's.
# A failed start prints its receipt on stdout (the one receipt) and exits with its code;
# an unverified one (a JVM started but its answer did not arrive in time) says so.
up() {
  local r rc=0
  r="$("$LOOP" ${flags[@]+"${flags[@]}"} up)" || rc=$?
  if [ "$rc" -eq 0 ]; then printf '%s\n' "$r" >&2; return 0; fi
  case "$r" in *'"status": "unverified"'*) unverified "$r" ;; esac
  echo "test-focus: the warm JVM did not start; see the receipt" >&2
  printf '%s\n' "$r"; exit "$rc"
}
down() { "$LOOP" ${flags[@]+"${flags[@]}"} down >&2 || true; }
status="$("$LOOP" ${flags[@]+"${flags[@]}"} status 2>/dev/null || true)"
# A wrong --root is a usage error, never a cold start: say so and spend no JVM.
case "$status" in
  *'not a Clojure project root'*)
    echo "test-focus: wrong --root (no JVM started); see the receipt for the paths tried" >&2
    printf '%s\n' "$status"; exit 2 ;;
esac
case "$status" in
  *'"status": "ready"'*) ;;
  *'"status": "tainted"'*) cold "warm JVM tainted"; down; up ;;
  *'"status": "unverified"'*) unverified "$status" ;;
  *'"status": "stopped"'*|*'no owned test process'*) cold "no warm JVM for this root"; up ;;
  *) echo "test-focus: the loop could not report on the warm JVM (no JVM started); see the receipt" >&2
     printf '%s\n' "$status"; exit 2 ;;
esac
out="$("$LOOP" ${flags[@]+"${flags[@]}"} ${checkflags[@]+"${checkflags[@]}"} check ${names[@]+"${names[@]}"} 2>"$block")" && rc=0 || rc=$?
case "$out" in
  *'runner or dependencies changed'*)
    cold "dependencies, runner or aliases changed"
    down; up
    out="$("$LOOP" ${flags[@]+"${flags[@]}"} ${checkflags[@]+"${checkflags[@]}"} check ${names[@]+"${names[@]}"} 2>"$block")" && rc=0 || rc=$? ;;
esac
printf '%s\n' "$out"
cat "$block" >&2
exit "$rc"
